{
  "media": {
    "images": {
      "default": "mai",
      "providers": [
        {
          "name": "mai",
          "baseUrl": "https://your-resource-si.services.ai.azure.com/mai/v1",
          "keyEnv": "AZURE_SI_KEY",
          "model": "mai-image-2.6",
          "sizeStyle": "size",
          "edits": true
        }
      ]
    },
    "video": {
      "baseUrl": "https://your-resource.openai.azure.com/openai/v1",
      "keyEnv": "AZURE_MEDIA_KEY",
      "model": "sora-2"
    },
    "speech": {
      "deepgramKeyEnv": "DEEPGRAM_API_KEY"
    }
  }
}
