# Copy to ~/.mochi/.env (mode 600). Only what you use; every feature without its key is off.

# Models: one of these, or the keyEnv your [providers] name.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Yes/no gates on routines and webhooks (optional; without it every gate passes).
# OPENROUTER_API_KEY=

# Web search, fetch and the logged-in browser.
# FIRECRAWL_API_KEY=
# FIRECRAWL_PROFILE=mochi

# Voice notes in and speech out.
# DEEPGRAM_API_KEY=

# iMessage through Photon Spectrum.
# PHOTON_PROJECT_ID=
# PHOTON_PROJECT_SECRET=
# IMESSAGE_OWNER=+15550100001

# Telegram.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_ID=

# WhatsApp Cloud API (needs a public webhook URL).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_OWNER=15550100001
# WHATSAPP_PORT=8787

# Webhooks and A2A. Bind 0.0.0.0 only behind a proxy.
# MOCHI_BIND_HOST=127.0.0.1
# MOCHI_HOOKS_PORT=8788
# MOCHI_PUBLIC_URL=https://mochi.example.com
# MOCHI_A2A_PEER_TOKENS=hermes:<token hermes sends>
# MOCHI_A2A_PORT=8789
